{
  "name": "party-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "build": "npm run build:production",
    "build:code": "npm run validate:fixture && npm run typecheck && vite build --mode fixture --outDir dist-fixture",
    "build:production": "npm run validate:content && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --mode fixture",
    "test:watch": "vitest --mode fixture",
    "test:e2e": "npm run test:e2e:fixture",
    "test:e2e:fixture": "playwright test",
    "test:e2e:content": "playwright test",
    "validate:data": "npm run validate:content",
    "validate:fixture": "tsx scripts/validate-data.ts --profile=fixture --root=tests/fixtures",
    "validate:content": "tsx scripts/validate-data.ts --profile=production --root=.",
    "manifest:fixture": "tsx scripts/generate-content-manifest.ts --root=tests/fixtures",
    "manifest:content": "tsx scripts/generate-content-manifest.ts --root=.",
    "data:report": "tsx scripts/data-report.ts --profile=production --root=.",
    "verify:code": "npm run validate:fixture && npm run lint && npm run typecheck && npm test && npm run build:code && npm run test:e2e:fixture",
    "verify:content": "npm run validate:content && npm run lint && npm run typecheck && npm test && npm run build:production && npm run test:e2e:content",
    "seed:private-people": "node scripts/seed-private-person-content.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "music-metadata": "11.15.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
